@model WebApplication1.Models.Domain.ShoppingCart
@{
    ViewData["Title"] = "Checkout";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
        <div>
            <h2 class="fw-bold text-white mb-1">Payment &amp; Order Summary</h2>
            <p class="text-secondary small mb-0">Enter customer information and amount tendered to complete the sale.</p>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-light px-3 py-2 fw-semibold">
            &larr; Back to Cart
        </a>
    </div>

    <div class="row g-4">
        <!-- Order Items Panel -->
        <div class="col-lg-7 col-xl-8">
            <div class="card border-secondary text-white h-100 shadow" style="background-color: #111827; border-radius: 12px;">
                <div class="card-header border-secondary bg-transparent py-3">
                    <h5 class="mb-0 fw-bold text-info">Order Items</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0 align-middle">
                            <thead>
                                <tr class="text-secondary small border-bottom border-secondary">
                                    <th class="ps-4 py-3">Product</th>
                                    <th class="text-center py-3">Qty</th>
                                    <th class="text-end pe-4 py-3">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="border-bottom border-secondary">
                                        <td class="ps-4 fw-medium py-3">@item.ProductName</td>
                                        <td class="text-center text-info fw-bold py-3">@("x" + item.Quantity)</td>
                                        <td class="text-end pe-4 fw-bold py-3">$@item.SubTotal.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer border-secondary bg-transparent py-3 pe-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-5 text-white fw-semibold">Grand Total Due:</span>
                        <span class="fs-2 fw-bold text-success">$@Model.GrandTotal.ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Processing Panel -->
        <div class="col-lg-5 col-xl-4">
            <div class="card border-secondary text-white shadow" style="background-color: #111827; border-radius: 12px;">
                <div class="card-header border-secondary bg-transparent py-3">
                    <h5 class="mb-0 fw-bold text-info">Customer &amp; Payment</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Checkout" asp-action="ProcessPayment" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label text-white fw-semibold">Customer Name *</label>
                            <input type="text" name="CustomerName" class="form-control bg-dark border-secondary text-white" placeholder="e.g. John Doe" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-white fw-semibold">Customer Email (Optional)</label>
                            <input type="email" name="CustomerEmail" class="form-control bg-dark border-secondary text-white" placeholder="john@example.com" />
                        </div>

                        <hr class="border-secondary my-4" />

                        <div class="mb-3">
                            <label class="form-label text-white fw-semibold">Grand Total</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-dark border-secondary text-white fw-bold">$</span>
                                <input type="text" class="form-control bg-dark border-secondary text-success fw-bold fs-3" value="@Model.GrandTotal.ToString("F2")" readonly />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-white fw-semibold">Amount Tendered *</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-dark border-secondary text-white fw-bold">$</span>
                                <input type="number" step="0.01" min="0" name="AmountTendered" class="form-control bg-dark border-secondary text-white fw-bold fs-3" placeholder="0.00" required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 fw-bold py-3 shadow">
                            Confirm &amp; Process Payment
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>