@using WebApplication1.Data
@model WebApplication1.Models.Domain.ShoppingCart
@{
    ViewData["Title"] = "Artisanal Bakery POS";
}

<style>
    body {
        background-color: #0b0f19;
        color: #f8fafc;
    }

    .pos-card {
        background-color: #111827;
        border: 1px solid #1f293d;
        border-radius: 12px;
    }

    .text-cyan {
        color: #0ea5e9;
    }

    .btn-cyan {
        background-color: #0284c7;
        color: #ffffff;
        border: none;
    }

        .btn-cyan:hover {
            background-color: #0369a1;
            color: #ffffff;
        }

    .table-dark-custom {
        background-color: transparent !important;
        color: #f8fafc !important;
    }

        .table-dark-custom th {
            background-color: #1a2234 !important;
            color: #94a3b8 !important;
            border-bottom: 1px solid #2d3748 !important;
        }

        .table-dark-custom td {
            background-color: transparent !important;
            color: #f8fafc !important;
            border-bottom: 1px solid #1f293d !important;
        }
</style>

<div class="container-fluid py-4 px-4">
    <!-- Header -->
    <div class="pos-card p-4 mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">🥖 Artisanal Bakery POS</h2>
            <p class="text-muted mb-0 small">Select products to build an order and proceed to checkout</p>
        </div>
        <span class="badge bg-cyan text-white px-3 py-2 rounded-pill fw-semibold">Active Session</span>
    </div>

    <div class="row g-4">
        <!-- Product Catalog -->
        <div class="col-lg-7 col-xl-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Product Catalog</h4>
                <span class="badge border border-secondary text-muted">@StaticDataStore.Products.Count Items Available</span>
            </div>

            <div class="row g-3">
                @foreach (var product in StaticDataStore.Products)
                {
                    <div class="col-md-6">
                        <div class="pos-card p-3 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold mb-0">@product.Name</h5>
                                    @if (product.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1">Out of Stock</span>
                                    }
                                    else if (product.StockQuantity <= 5)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">Low Stock (@product.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white px-2 py-1">In Stock (@product.StockQuantity)</span>
                                    }
                                </div>
                                <h4 class="fw-bold text-cyan mb-3">$@product.Price.ToString("F2")</h4>
                            </div>

                            @if (product.StockQuantity > 0)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="ProductId" value="@product.Id" />
                                    <input type="number" name="Quantity" value="1" min="1" max="@product.StockQuantity" class="form-control bg-dark text-white border-secondary text-center" style="width: 70px;" />
                                    <button type="submit" class="btn btn-cyan flex-grow-1 fw-semibold">+ Add to Cart</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-dark text-muted w-100" disabled>Unavailable</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Current Order / Shopping Cart -->
        <div class="col-lg-5 col-xl-4">
            <div class="pos-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold mb-0">Current Order</h4>
                        <span class="badge bg-cyan text-white">@Model.Items.Sum(i => i.Quantity) items</span>
                    </div>

                    @if (!Model.Items.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <p class="mb-0">Cart is empty. Select items from the catalog.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark-custom align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-end">Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td class="fw-medium">@item.ProductName</td>
                                            <td class="text-center" style="width: 90px;">
                                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-inline">
                                                    <input type="hidden" name="ProductId" value="@item.ProductId" />
                                                    <input type="number" name="Quantity" value="@item.Quantity" min="1" onchange="this.form.submit()" class="form-control form-control-sm bg-dark text-white border-secondary text-center px-1" />
                                                </form>
                                            </td>
                                            <td class="text-end fw-bold">$@item.SubTotal.ToString("F2")</td>
                                            <td class="text-end" style="width: 30px;">
                                                <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" class="d-inline">
                                                    <input type="hidden" name="ProductId" value="@item.ProductId" />
                                                    <button type="submit" class="btn btn-link text-danger p-0 border-0 text-decoration-none">✕</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Grand Total & Checkout -->
                <div class="mt-4 pt-3 border-top border-secondary">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted fs-5">Grand Total</span>
                        <span class="fs-2 fw-bold text-success">$@Model.GrandTotal.ToString("F2")</span>
                    </div>

                    @if (Model.Items.Any())
                    {
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-success btn-lg w-100 fw-bold py-3">
                            Proceed to Checkout &rarr;
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg w-100 fw-bold py-3" disabled>
                            Proceed to Checkout &rarr;
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>